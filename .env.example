# Copie para .env (não versionado) e preencha. Nunca coloque chaves no código.

# Diretório de armazenamento dos projetos (originais, intermediários, saídas)
CHESSBOOK_STORAGE_DIR=./storage

# Diretório local com PDFs reais para testes manuais (fora do repositório)
CHESSBOOK_SAMPLES_DIR=

# Privacidade: local_only bloqueia qualquer provedor remoto.
# Para usar Claude, ChatGPT ou Gemini, troque explicitamente para remote_allowed.
CHESSBOOK_PRIVACY_MODE=local_only

# Provedor de tradução: anthropic | openai | gemini | fake (teste, sem envio)
CHESSBOOK_TRANSLATION_PROVIDER=fake

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CHESSBOOK_ANTHROPIC_MODEL=claude-opus-5-5
CHESSBOOK_ANTHROPIC_EFFORT=high
# Reexecuta no modelo de reserva da Anthropic se houver recusa por política (on/off)
CHESSBOOK_ANTHROPIC_FALLBACKS=on

# --- ChatGPT (OpenAI) --- o modelo é obrigatório; use um nome listado na sua conta
OPENAI_API_KEY=
CHESSBOOK_OPENAI_MODEL=
# Opcional, para modelos com raciocínio: low | medium | high
CHESSBOOK_OPENAI_REASONING_EFFORT=

# --- Gemini (Google) --- o modelo é obrigatório; use um nome listado na sua conta
GEMINI_API_KEY=
CHESSBOOK_GEMINI_MODEL=
