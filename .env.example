# Copie para .env (não versionado). Nenhuma credencial é necessária na Fase 1.

# Diretório de armazenamento dos projetos (originais, intermediários, saídas)
CHESSBOOK_STORAGE_DIR=./storage

# Diretório local com PDFs reais para testes manuais (fora do repositório)
CHESSBOOK_SAMPLES_DIR=

# Privacidade: local_only bloqueia qualquer provedor remoto
CHESSBOOK_PRIVACY_MODE=local_only

# Provedor remoto de tradução (opcional, Fase 4)
ANTHROPIC_API_KEY=
