# Copie para .env (não versionado) e preencha. Nunca coloque chaves no código.

# Pasta dos projetos (o livro, as traduções, os backups). Padrão: ./storage, fora do controle de versão.
CHESSBOOK_STORAGE=

# Diretório local com PDFs reais para testes manuais (fora do repositório)
CHESSBOOK_SAMPLES_DIR=

# Privacidade: local_only bloqueia qualquer provedor remoto.
# Para usar Claude, ChatGPT ou Gemini, troque explicitamente para remote_allowed.
CHESSBOOK_PRIVACY_MODE=local_only

# Na interface, o motor é escolhido na aba Traduzir (todos pela Pollinations). As variáveis abaixo
# valem para os scripts de linha de comando.
# Provedor de tradução: pollinations | anthropic | openai | gemini | fake (teste, sem envio)
CHESSBOOK_TRANSLATION_PROVIDER=fake

# --- Pollinations (uma chave sk_ para modelos de vários fornecedores) ---
POLLINATIONS_API_KEY=
# Id do modelo em https://gen.pollinations.ai/v1/models, por exemplo:
#   openai/gpt-5.5 · google/gemini-3.8-flash · qwen/qwen3.8-max
CHESSBOOK_POLLINATIONS_MODEL=
# schema (padrão) | object | none — use object/none se o modelo não aceitar JSON Schema
CHESSBOOK_POLLINATIONS_JSON=schema
CHESSBOOK_POLLINATIONS_REASONING_EFFORT=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CHESSBOOK_ANTHROPIC_MODEL=claude-opus-5-5
CHESSBOOK_ANTHROPIC_EFFORT=high
# Reexecuta no modelo de reserva da Anthropic se houver recusa por política (on/off)
CHESSBOOK_ANTHROPIC_FALLBACKS=on

# --- ChatGPT (OpenAI) --- o modelo é obrigatório; use um nome listado na sua conta
OPENAI_API_KEY=
CHESSBOOK_OPENAI_MODEL=
# Opcional, para modelos com raciocínio: low | medium | high
CHESSBOOK_OPENAI_REASONING_EFFORT=

# --- Gemini (Google) --- o modelo é obrigatório; use um nome listado na sua conta
GEMINI_API_KEY=
CHESSBOOK_GEMINI_MODEL=

# Seções traduzidas ao mesmo tempo (1–8). O teto de gasto vale para o conjunto.
CHESSBOOK_TRANSLATION_WORKERS=3

# Envio de PDF pela interface: tamanho e páginas máximos.
CHESSBOOK_MAX_UPLOAD_MB=500
CHESSBOOK_MAX_PAGES=3000

# Nomes extras pelos quais a interface pode ser acessada (separados por vírgula). Sem isso, só
# localhost/127.0.0.1 — proteção contra páginas da web que tentam usar o servidor local.
CHESSBOOK_ALLOWED_HOSTS=
